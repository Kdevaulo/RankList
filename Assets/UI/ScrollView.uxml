<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:Template name="Rank" src="project://database/Assets/UI/Rank.uxml?fileID=9197481963319205126&amp;guid=a20574acd84ca8349931b9dc8e44e188&amp;type=3#Rank" />
    <ui:Template name="RankGainIndicator" src="project://database/Assets/UI/RankGainIndicator.uxml?fileID=9197481963319205126&amp;guid=57eb5797859e3464ab7fc07a2f193c61&amp;type=3#RankGainIndicator" />
    <Style src="project://database/Assets/UI/ScrollStyle.uss?fileID=7433441132597879392&amp;guid=fc9a137f50d412444bd9cdc35736f4f7&amp;type=3#ScrollStyle" />
    <ui:VisualElement name="Root" style="flex-grow: 1; background-color: rgb(0, 25, 38);">
        <ui:VisualElement name="Container" style="height: 100px;" />
        <ui:VisualElement name="Container" style="flex-grow: 1;">
            <ui:ScrollView name="RanksList" mode="VerticalAndHorizontal" vertical-scroller-visibility="Hidden" horizontal-scroller-visibility="Hidden" style="gap: 20px; flex-grow: 1;">
                <ui:VisualElement name="RanksContainer" style="flex-direction: row; padding-left: 26px; padding-right: 26px; flex-grow: 1;">
                    <ui:Instance template="Rank" name="Rank" />
