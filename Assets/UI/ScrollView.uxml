                        <ui:Instance template="RankGainIndicator" name="RankGainIndicator" />
                        <ui:Instance template="RankGainIndicator" name="RankGainIndicator" />
                        <ui:Instance template="RankGainIndicator" name="RankGainIndicator" />
                        <ui:Instance template="RankGainIndicator" name="RankGainIndicator" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="RankProgressBar" style="height: 180px; margin-top: -4px; border-top-color: rgb(118, 255, 51); border-top-width: 4px; margin-left: 120px; width: 0; border-right-color: rgba(118, 255, 51, 0.75); border-right-width: 1px; overflow: hidden; visibility: hidden;">
                    <ui:VisualElement name="ScoreContainer" style="flex-direction: row; align-items: center; justify-content: flex-end; -unity-font: url(&apos;project://database/Assets/Fonts/Rubik-Regular.ttf?fileID=12800000&amp;guid=e5b28ff9cb5fec94a83683be662307b5&amp;type=3#Rubik-Regular&apos;); padding-top: 12px; padding-right: 16px;">
                        <ui:VisualElement name="Image" style="height: 18px; width: 18px; background-image: url(&apos;project://database/Assets/ArtAssets/xp.png?fileID=2800000&amp;guid=a6ec302c5e5fc744ba0bb081a57330a8&amp;type=3#xp&apos;); margin-right: 4px;" />
                        <ui:Label tabindex="-1" text="0" parse-escape-sequences="true" display-tooltip-when-elided="true" name="Score" style="-unity-text-align: upper-center; -unity-font: url(&apos;project://database/Assets/Fonts/Rubik-Regular.ttf?fileID=12800000&amp;guid=e5b28ff9cb5fec94a83683be662307b5&amp;type=3#Rubik-Regular&apos;); font-size: 24px; color: rgb(118, 255, 51); margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;" />
                    </ui:VisualElement>
