                    <ui:Instance template="Rank" name="Rank" />
                    <ui:Instance template="Rank" name="Rank" />
                </ui:VisualElement>
                <ui:VisualElement name="RankGainContainer" style="height: 24px; flex-direction: row; margin-left: 120px;">
                    <ui:VisualElement name="Wrapper" style="flex-direction: row;">
                        <ui:VisualElement name="LastIndicator" class="lastIndicator" style="flex-grow: 1; position: absolute; right: 0; top: 0; height: 20px; width: 1px;" />
                        <ui:Instance template="RankGainIndicator" name="RankGainIndicator" />
                        <ui:Instance template="RankGainIndicator" name="RankGainIndicator" />
                        <ui:Instance template="RankGainIndicator" name="RankGainIndicator" />
